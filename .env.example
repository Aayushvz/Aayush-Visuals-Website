# Copy to .env.local for local development. Vercel reads its own copy from
# Project Settings -> Environment Variables, not from this file.

# Where the heavy video is served from. See lib/mediaSrc.ts for why.
#
# Unset (the default), every asset is served from public/ and the site
# behaves exactly as it always has. Set, the seven .webm files are fetched
# from this origin instead, which keeps ~15MB out of every deployment and
# off the Vercel Deployment Storage meter. Images are never rewritten.
#
# No trailing slash needed; one is stripped if present. The bucket must
# mirror the repo's own paths, so this file:
#
#   public/projects/mike-tyson/homepage.webm
#
# has to be reachable at:
#
#   $NEXT_PUBLIC_MEDIA_BASE/projects/mike-tyson/homepage.webm
#
# DO IT IN THIS ORDER, or the case study loses its media:
#   1. upload public/projects/mike-tyson/*.webm and
#      public/projects/mike-tyson-bg.webm, keeping the paths above
#   2. set this variable in Vercel and redeploy
#   3. confirm the videos still play on /work/mike-tyson-invitational
#   4. only then delete the local copies and commit that
#
# NEXT_PUBLIC_MEDIA_BASE=https://your-bucket.example.com
